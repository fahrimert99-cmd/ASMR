# ------------------------------------------------------------------
# Shorts uretici ayarlari. kurulum.py bunu shorts/.env olarak kopyalar.
# shorts/.env .gitignore'dadir; repoya gitmez.
# ------------------------------------------------------------------

# --- Dil modeli: en iyi anlari secer ---
# Varsayilan: bilgisayarinizdaki Ollama (UCRETSIZ, API anahtari GEREKMEZ).
# OPENAI_API_KEY=ollama gercek bir anahtar degildir; alan bos kalmasin diye yazilir.
LLM_PROVIDER=openai
OPENAI_API_KEY=ollama
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_MODEL=qwen2.5:7b
# Bilgisayariniz zayifsa (8 GB RAM alti) daha kucuk model: qwen2.5:3b
#   (degistirirseniz: ollama pull qwen2.5:3b)

# Alternatif (ucretsiz ama anahtarli): Google Gemini - https://aistudio.google.com
# Kullanmak icin yukaridaki 4 satiri silip sunlari acin + pip install google-genai:
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=BURAYA_GEMINI_ANAHTARINIZ
# GEMINI_MODEL=gemini-2.5-flash

# --- Konusmayi yaziya dokme (Whisper, bilgisayarinizda calisir) ---
# tiny / base / small / medium / large-v3  (buyudukce Turkce daha dogru, daha yavas)
LOCAL_WHISPER_MODEL=small
# auto / cpu / cuda  (NVIDIA ekran karti varsa auto onu kullanir)
LOCAL_WHISPER_DEVICE=auto

# --- Altyazi ---
# 1 = BUYUK HARF (Shorts/TikTok tarzi), 0 = normal yazim
ALTYAZI_BUYUK_HARF=1
